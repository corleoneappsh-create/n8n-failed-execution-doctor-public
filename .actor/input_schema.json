{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "n8n Failed Execution Doctor",
    "description": "Diagnose a failed n8n execution from a workflow export and execution JSON. No credentials or live n8n access required.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "workflow": {
            "title": "n8n workflow JSON",
            "type": "object",
            "description": "Exported n8n workflow object. A safe synthetic demo is prefilled so the Actor can be tested immediately.",
            "editor": "json",
            "prefill": {
                "name": "Demo Lead Sync",
                "nodes": [
                    {
                        "name": "CRM API",
                        "type": "n8n-nodes-base.httpRequest"
                    }
                ]
            },
            "example": {
                "name": "Demo Lead Sync",
                "nodes": [
                    {
                        "name": "CRM API",
                        "type": "n8n-nodes-base.httpRequest"
                    }
                ]
            }
        },
        "execution": {
            "title": "Failed execution JSON",
            "type": "object",
            "description": "Saved or API-returned failed n8n execution object. A synthetic 401 failure is prefilled; remove sensitive data from real exports.",
            "editor": "json",
            "prefill": {
                "data": {
                    "resultData": {
                        "lastNodeExecuted": "CRM API",
                        "runData": {
                            "CRM API": [
                                {
                                    "error": {
                                        "message": "Request failed: unauthorized",
                                        "httpCode": 401
                                    }
                                }
                            ]
                        }
                    }
                }
            },
            "example": {
                "data": {
                    "resultData": {
                        "lastNodeExecuted": "CRM API",
                        "runData": {
                            "CRM API": [
                                {
                                    "error": {
                                        "message": "Request failed: unauthorized",
                                        "httpCode": 401
                                    }
                                }
                            ]
                        }
                    }
                }
            }
        }
    },
    "required": ["workflow", "execution"]
}
